{
  "name": "nuxt-lite",
  "version": "0.0.8",
  "description": "Static site generation with custom lightweight hydration for Nuxt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelenoSalgado/nuxt-lite.git"
  },
  "license": "MIT",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "static-site-generation",
    "ssg",
    "vue"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "prepack": "npm run build:runtime && nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "npm run build:runtime && nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "build:runtime": "esbuild src/runtime/lite.ts --bundle --minify --outfile=dist/runtime/lite.min.js --format=iife",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.2",
    "better-sqlite3": "^13.0.1",
    "linkedom": "^0.18.12"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/test-utils": "^4.0.0",
    "changelogen": "^0.6.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.2.0",
    "nuxt": "^4.4.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.6"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "unrs-resolver@1.11.1": true,
    "esbuild@0.28.1": true
  }
}
